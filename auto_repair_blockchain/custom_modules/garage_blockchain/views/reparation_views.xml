<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue liste réparations -->
        <record id="view_reparation_list" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.list</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <list string="Réparations" 
                      decoration-info="state == 'planifie'" 
                      decoration-warning="state == 'en_cours'" 
                      decoration-success="state == 'termine'"
                      decoration-muted="state == 'facture'"
                      decoration-danger="state == 'annule'">
                    <field name="name"/>
                    <field name="date_debut"/>
                    <field name="mecanicien_id"/>
                    <field name="voiture_id"/>
                    <field name="type_reparation"/>
                    <field name="priorite" decoration-danger="priorite == 'urgente'" 
                           decoration-warning="priorite == 'haute'"/>
                    <field name="duree" sum="Total heures"/>
                    <field name="cout_total" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="state" 
                           decoration-info="state == 'planifie'" 
                           decoration-warning="state == 'en_cours'" 
                           decoration-success="state == 'termine'"
                           decoration-muted="state == 'facture'"
                           decoration-danger="state == 'annule'"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Vue recherche/filtres réparations -->
        <record id="view_reparation_search" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.search</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <search string="Recherche Réparations">
                    <field name="name"/>
                    <field name="mecanicien_id"/>
                    <field name="voiture_id"/>
                </search>
            </field>
        </record>

        <!-- Vue kanban réparations -->
        <record id="view_reparation_kanban" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.kanban</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="state"/>
                    <field name="priorite"/>
                    <field name="type_reparation"/>
                    <field name="voiture_id"/>
                    <field name="mecanicien_id"/>
                    <field name="date_debut"/>
                    <field name="duree"/>
                    <field name="cout_total"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <field name="priorite" widget="badge" 
                                       decoration-danger="priorite == 'urgente'"
                                       decoration-warning="priorite == 'haute'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>🔧 <field name="type_reparation"/></div>
                                <div>🚗 <field name="voiture_id"/></div>
                                <div>👨‍🔧 <field name="mecanicien_id"/></div>
                                <div>📅 <field name="date_debut"/></div>
                                <div t-if="record.duree.raw_value > 0">
                                    ⏱️ <field name="duree"/> h
                                </div>
                                <div>💰 <field name="cout_total"/> MAD</div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vue calendrier réparations -->
        <record id="view_reparation_calendar" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.calendar</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <calendar string="Réparations" 
                          date_start="date_debut" 
                          date_stop="date_fin"
                          color="mecanicien_id"
                          mode="month">
                    <field name="voiture_id"/>
                    <field name="mecanicien_id"/>
                    <field name="type_reparation"/>
                </calendar>
            </field>
        </record>

        <!-- Vue pivot réparations -->
        <record id="view_reparation_pivot" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.pivot</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <pivot string="Analyse des réparations">
                    <field name="mecanicien_id" type="row"/>
                    <field name="type_reparation" type="row"/>
                    <field name="cout_total" type="measure"/>
                    <field name="duree" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Vue graphique réparations -->
        <record id="view_reparation_graph" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.graph</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <graph string="Statistiques réparations" type="bar">
                    <field name="mecanicien_id"/>
                    <field name="cout_total" type="measure"/>
                    <field name="duree" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Vue formulaire réparation -->
        <record id="view_reparation_form" model="ir.ui.view">
            <field name="name">mecanicien_v2.reparation.form</field>
            <field name="model">mecanicien_v2.reparation</field>
            <field name="arch" type="xml">
                <form string="Réparation">
                    <header>
                        <button name="action_start" string="Démarrer" type="object" 
                                class="oe_highlight" 
                                invisible="state != 'planifie'"/>
                        <button name="action_complete" string="Terminer" type="object" 
                                class="oe_highlight" 
                                invisible="state != 'en_cours'"/>
                        <button name="action_invoice" string="Facturer" type="object" 
                                class="oe_highlight" 
                                invisible="state != 'termine'"/>
                        <button name="action_cancel" string="Annuler" type="object" 
                                invisible="state in ('termine', 'facture', 'annule')"/>
                        <button name="action_blockchain_transfer" 
                                string="🔗 Enregistrer sur Blockchain" 
                                type="object" 
                                class="oe_highlight" 
                                confirm="Voulez-vous enregistrer cette réparation de manière immuable sur la blockchain Polygon ?"
                                invisible="blockchain_tx or state not in ('termine', 'facture')"/>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="planifie,en_cours,termine,facture"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Smart buttons peuvent être ajoutés ici -->
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Informations principales">
                                <field name="voiture_id" 
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="mecanicien_id" 
                                       domain="[('is_mecanicien', '=', True)]"
                                       options="{'no_create': True}"/>
                                <field name="type_reparation"/>
                                <field name="priorite"/>
                                <field name="kilometrage_intervention"/>
                            </group>
                            <group string="Dates et durée">
                                <field name="date_debut"/>
                                <field name="date_fin" readonly="state != 'en_cours'"/>
                                <field name="duree" widget="float_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <group>
                                    <field name="description" nolabel="1" 
                                           placeholder="Décrivez le problème et les travaux à effectuer..."/>
                                </group>
                            </page>
                            <page string="Pièces et Coûts" name="couts">
                                <group>
                                    <group string="Pièces utilisées">
                                        <field name="pieces_utilisees" nolabel="1" 
                                               placeholder="Liste des pièces remplacées..."/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Détail des coûts">
                                        <field name="cout_pieces" widget="monetary"/>
                                        <field name="cout_main_oeuvre" widget="monetary"/>
                                        <field name="cout_total" readonly="1" widget="monetary" 
                                               class="oe_subtotal_footer_separator"/>
                                    </group>
                                    <group string="Facturation">
                                        <field name="facture" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Notes techniques" name="notes">
                                <field name="notes_techniques" nolabel="1" 
                                       placeholder="Notes techniques pour le mécanicien..."/>
                            </page>
                            <page string="Satisfaction client" name="satisfaction">
                                <group>
                                    <field name="satisfaction_client" widget="priority"/>
                                </group>
                            </page>
                            <page string="🔗 Blockchain" name="blockchain">
                                <group string="Preuve d'immuabilité — Ethereum Sepolia Testnet">
                                    <group>
                                        <field name="blockchain_tx" readonly="1"/>
                                        <field name="blockchain_hash" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="blockchain_url" widget="url" 
                                               text="Voir sur Etherscan" 
                                               invisible="not blockchain_tx"/>
                                    </group>
                                </group>
                                <div invisible="blockchain_tx" class="text-muted">
                                    <p>Aucune transaction blockchain enregistrée pour cette réparation.</p>
                                    <p>Terminez la réparation puis cliquez sur <b>"🔗 Enregistrer sur Blockchain"</b> dans l'en-tête.</p>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action pour les réparations -->
        <record id="action_reparation" model="ir.actions.act_window">
            <field name="name">Réparations</field>
            <field name="res_model">mecanicien_v2.reparation</field>
            <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
            <field name="search_view_id" ref="view_reparation_search"/>
            <field name="context">{'search_default_filter_en_cours': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre première réparation !
                </p>
                <p>
                    Planifiez et suivez les interventions sur les véhicules de l'atelier.
                </p>
            </field>
        </record>
    </data>
</odoo>