# ============================================================
# Variables d'environnement pour l'intégration Blockchain
# Copier ce fichier en .env et renseigner les valeurs
# ============================================================

# URL du provider RPC Polygon Amoy Testnet (Alchemy / Infura / autre)
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/VOTRE_CLE_API_ALCHEMY

# Clé privée du wallet propriétaire du smart contract (SANS le préfixe 0x)
# ⚠️  NE JAMAIS COMMITTER CE FICHIER AVEC LA VRAIE CLÉ
BLOCKCHAIN_PRIVATE_KEY=votre_cle_privee_ici

# Adresse du smart contract déployé sur Polygon Amoy
BLOCKCHAIN_CONTRACT_ADDRESS=0xAdresseDeVotreContratDeploye

# Chain ID du réseau (80002 = Polygon Amoy Testnet)
BLOCKCHAIN_CHAIN_ID=80002
